{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bsky-rss",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "bskyrss.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
  },
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["nodejs_compat"],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "bsky_rss_feed_requests",
    },
  ],
}
